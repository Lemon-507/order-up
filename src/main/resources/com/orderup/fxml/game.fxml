<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="gameRoot" prefHeight="720.0" prefWidth="1280.0"
           stylesheets="@../css/game.css"
           xmlns="http://javafx.com/javafx/17.0.10" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.orderup.view.GameView">
    <HBox alignment="CENTER" maxHeight="720.0" maxWidth="1280.0" prefHeight="720.0" prefWidth="1280.0">
        <Canvas fx:id="gameCanvas" height="720.0" width="1040.0" />
        <AnchorPane prefHeight="720.0" prefWidth="240.0" styleClass="hud-panel">
            <Label fx:id="timeLabel" alignment="CENTER" layoutX="31.0" layoutY="27.0"
                   prefHeight="73.0" prefWidth="178.0" styleClass="time-label" text="10:00" />
            <Button accessibleText="暂停游戏" layoutX="82.0" layoutY="108.0"
                    onAction="#onPauseButtonClick" prefHeight="42.0" prefWidth="112.0"
                    styleClass="pause-button" text="暂停" />

            <VBox layoutX="12.0" layoutY="164.0" prefWidth="216.0" spacing="8.0"
                  styleClass="order-panel">
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="order-header">
                    <Label styleClass="order-caption" text="订单" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="scoreLabel" styleClass="score-label" text="得分 0" />
                </HBox>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" maxHeight="476.0"
                            pannable="true" styleClass="order-scroll" vbarPolicy="AS_NEEDED">
                    <content>
                        <VBox fx:id="ordersBox" spacing="8.0" />
                    </content>
                </ScrollPane>
            </VBox>

            <Label fx:id="interactionMessageLabel" alignment="CENTER" layoutX="12.0" layoutY="650.0"
                   prefWidth="162.0" styleClass="interaction-message" text="" visible="false"
                   wrapText="true" />
            <Button fx:id="musicToggleButton" accessibleText="关闭音乐" layoutX="184.0" layoutY="664.0"
                    onAction="#onMusicToggleButtonClick" prefHeight="44.0" prefWidth="44.0"
                    styleClass="music-toggle-button" text="♫" />
        </AnchorPane>
    </HBox>

    <StackPane fx:id="pauseOverlay" managed="false" styleClass="pause-overlay" visible="false">
        <AnchorPane maxHeight="480.0" maxWidth="460.0" prefHeight="480.0" prefWidth="460.0"
                    styleClass="pause-panel">
            <Button fx:id="continueButton" accessibleText="继续游戏" defaultButton="true"
                    layoutX="124.0" layoutY="160.0" onAction="#onContinueButtonClick"
                    prefHeight="63.0" prefWidth="212.0" styleClass="pause-hotspot" text="继续游戏" />
            <Button accessibleText="选择关卡" layoutX="124.0" layoutY="234.0"
                    onAction="#onLevelSelectButtonClick" prefHeight="63.0" prefWidth="212.0"
                    styleClass="pause-hotspot" text="选择关卡" />
            <Button accessibleText="退出主菜单" layoutX="124.0" layoutY="308.0"
                    onAction="#onMenuButtonClick" prefHeight="63.0" prefWidth="212.0"
                    styleClass="pause-hotspot" text="退出主菜单" />
        </AnchorPane>
    </StackPane>
</StackPane>
